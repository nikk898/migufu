PORT=3000

# Supabase > Connect (use o Session pooler se a conexão direta falhar)
DATABASE_URL=

# String longa e aleatória (gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# Endereço de onde o front é aberto (Live Server). Mais de um: separe por vírgula
FRONTEND_URL=http://127.0.0.1:5500

# Brevo: chave em SMTP & API > API Keys (acesso restrito, só Transactional email)
BREVO_API_KEY=
# E-mail remetente verificado no Brevo
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Migufu

# Página do front que recebe o link de redefinição de senha
URL_REDEFINIR_SENHA=http://127.0.0.1:5500/front-end-teste/pages/recuperar-senha.html